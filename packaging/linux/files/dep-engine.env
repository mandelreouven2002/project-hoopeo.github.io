# DEP Engine configuration, read by the dep-engine systemd service.
# After a change: sudo systemctl restart dep-engine

# Where to listen. 127.0.0.1 accepts connections from this machine only; use 0.0.0.0:5433
# to accept them from the network (then turn TLS on, below, and open the firewall port).
DEP_LISTEN=127.0.0.1:5433

# The database and its master key.
DEP_DATA_DIR=/var/lib/dep-engine/data

# The admin password of a new database, generated when the package was installed.
DEP_INIT_ADMIN_PASSWORD_FILE=/etc/dep-engine/admin-password

# TLS. Either a certificate and key (PEM), readable by the dep-engine user:
#DEP_TLS_CERT=/etc/dep-engine/tls/server.crt
#DEP_TLS_KEY=/etc/dep-engine/tls/server.key
# or a self-signed certificate, created in /var/lib/dep-engine/data/tls on the first start
# (clients connect with --sslmode require, or verify-full with that certificate as CA):
#DEP_TLS_SELF_SIGNED=1
#DEP_TLS_HOSTS=db.example.com

# Refuse connections without TLS (needs a certificate, above):
#DEP_TLS_REQUIRED=1

# The HTTP API (HTTPS with the certificate above): /v1/query, /v1/health, /metrics
#DEP_HTTP_LISTEN=127.0.0.1:8433

# A limit on protected matches for every role that is not a superuser:
#DEP_MATCH_LIMIT=1000/minute

# Resources (defaults: query memory 1/4 of RAM, data file cache 1/8 of RAM up to 4GB):
#DEP_MEMORY_LIMIT=4GB
#DEP_CACHE_SIZE=2GB
# A transaction left idle is rolled back after this many seconds (0: never):
#DEP_IDLE_IN_TRANSACTION_TIMEOUT=300
#DEP_MAX_CONNECTIONS=200

# A DEP SQL script run once, when the database is new:
#DEP_INIT=/usr/share/dep-engine/examples/clinic.sql
