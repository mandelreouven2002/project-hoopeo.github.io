[Unit]
Description=DEP Engine, the Database-Enforced Privacy server (Project Hoopeo)
Documentation=https://lp.reuven.click
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dep-engine
Group=dep-engine
EnvironmentFile=/etc/dep-engine/dep-engine.env
ExecStart=/usr/bin/dep-engine
Restart=on-failure
RestartSec=3
StateDirectory=dep-engine
StateDirectoryMode=0700
WorkingDirectory=/var/lib/dep-engine
# Hardening: the server needs its state directory, its configuration and the network, nothing more.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/dep-engine
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
