{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hoopeo Studio",
  "version": "0.5.2",
  "identifier": "click.reuven.hoopeo.studio",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "splash",
        "title": "Hoopeo Studio",
        "url": "splash.html",
        "width": 620,
        "height": 360,
        "center": true,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false
      },
      {
        "label": "main",
        "title": "Hoopeo Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "(c) Reuven Mandelovich, lp.reuven.click",
    "publisher": "Reuven Mandelovich",
    "category": "DeveloperTool",
    "shortDescription": "The developer application for DEP SQL"
  }
}